generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                Int                     @id @default(autoincrement())
  nombre            String                  @db.VarChar(200)
  email             String                  @unique @db.VarChar(200)
  passwordHash      String                  @map("password_hash") @db.VarChar(255)
  rol               String                  @default("ANALISTA") @db.VarChar(20)
  usuarioErp        String                  @map("usuario_erp") @db.VarChar(10)
  activo            Boolean                 @default(false)
  agregoUsuario     Int                     @default(0) @map("agrego_usuario")
  agregoFecha       DateTime                @default(now()) @map("agrego_fecha")
  modificoUsuario   Int                     @default(0) @map("modifico_usuario")
  modificoFecha     DateTime                @updatedAt @map("modifico_fecha")
  registroVersion   Int                     @default(1) @map("registro_version")
  auditLogs         AuditLog[]
  contratoAprobados Contrato[]              @relation("ContratoAprobador")
  contratosCreados  Contrato[]              @relation("ContratoCreador")
  costeosAprobados  Costeo[]                @relation("CosteoAprobador")
  costeosCreados    Costeo[]                @relation("CosteoCreador")
  historiales       HistorialAutoGuardado[]

  @@map("t_usuario")
}

model Cliente {
  id                      Int        @id @default(autoincrement())
  empresaId               Int        @default(0) @map("empresa_id")
  codigoTemp              String?    @map("codigo_temp") @db.VarChar(50)
  nit                     String     @db.VarChar(30)
  razonSocial             String     @map("razon_social") @db.VarChar(200)
  direccionFiscal         String?    @map("direccion_fiscal") @db.VarChar(150)
  direccionPaisId         Int        @default(0) @map("direccion_pais_id")
  direccionDepartamentoId Int        @default(0) @map("direccion_departamento_id")
  direccionMunicipioId    Int        @default(0) @map("direccion_municipio_id")
  diasCredito             Int        @default(0) @map("dias_credito")
  codigoErp               String?    @map("codigo_erp") @db.VarChar(15)
  usuarioCreo             Int        @default(0) @map("usuario_creo")
  fechaCreo               DateTime   @default(now()) @map("fecha_creo")
  registroVersion         Int        @default(1) @map("registro_version")
  sincronizadoEn          DateTime?  @map("sincronizado_en")
  contratos               Contrato[]

  @@map("costeos_cliente")
}

model Contrato {
  id            Int       @id @default(autoincrement())
  clienteId     Int       @map("cliente_id")
  numero        String    @db.VarChar(50)
  nombre        String    @db.VarChar(200)
  fechaInicio   DateTime  @map("fecha_inicio") @db.Date
  plazoMeses    Int       @map("plazo_meses")
  moneda        String    @default("GTQ") @db.VarChar(10)
  estado        String    @default("BORRADOR") @db.VarChar(20)
  erpContratoId Int?      @map("erp_contrato_id")
  notas         String?   @db.Text
  aprobadoPor   Int?      @map("aprobado_por")
  aprobadoEn    DateTime? @map("aprobado_en")
  creadoPor     Int       @map("creado_por")
  creadoEn      DateTime  @default(now()) @map("creado_en")
  modificadoEn  DateTime  @updatedAt @map("modificado_en")
  empresaId     Int       @default(1) @map("empresa_id")
  aprobador     Usuario?  @relation("ContratoAprobador", fields: [aprobadoPor], references: [id])
  cliente       Cliente   @relation(fields: [clienteId], references: [id])
  creador       Usuario   @relation("ContratoCreador", fields: [creadoPor], references: [id])
  costeo        Costeo?
  nodos         Nodo[]

  @@index([aprobadoPor], map: "costeos_contrato_aprobado_por_fkey")
  @@index([clienteId], map: "costeos_contrato_cliente_id_fkey")
  @@index([creadoPor], map: "costeos_contrato_creado_por_fkey")
  @@map("costeos_contrato")
}

model Nodo {
  id             Int           @id @default(autoincrement())
  contratoId     Int           @map("contrato_id")
  parentId       Int?          @map("parent_id")
  nivel          Int           @default(1)
  codigo         String?       @db.VarChar(20)
  nombre         String        @db.VarChar(200)
  direccion      String?       @db.VarChar(500)
  pais           String?       @db.VarChar(100)
  departamento   String?       @db.VarChar(100)
  municipio      String?       @db.VarChar(100)
  latitud        Decimal?      @db.Decimal(10, 7)
  longitud       Decimal?      @db.Decimal(10, 7)
  diasCobertura  String?       @map("dias_cobertura") @db.VarChar(100)
  horaInicio     String?       @map("hora_inicio") @db.VarChar(5)
  horaFin        String?       @map("hora_fin") @db.VarChar(5)
  personas       Int           @default(1)
  horasSemana    Int           @default(0) @map("horas_semana")
  turnoCodigo    Int?          @map("turno_codigo")
  uniformeCodigo String?       @map("uniforme_codigo") @db.VarChar(50)
  cubreDescanso  Int           @default(0) @map("cubre_descanso")
  combosRhSelec  String?       @map("combos_rh_seleccionados") @db.Text
  contrato       Contrato      @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  parent         Nodo?         @relation("JerarquiaNodos", fields: [parentId], references: [id], onDelete: Cascade)
  children       Nodo[]        @relation("JerarquiaNodos")
  recursos       NodoRecurso[]

  @@index([contratoId], map: "costeos_nodo_contrato_id_fkey")
  @@index([parentId], map: "costeos_nodo_parent_id_fkey")
  @@map("costeos_nodo")
}

model NodoRecurso {
  id                Int           @id @default(autoincrement())
  nodoId            Int           @map("nodo_id")
  itemNombre        String        @map("item_nombre") @db.VarChar(200)
  itemTipo          String        @map("item_tipo") @db.VarChar(30)
  itemCategoria     String        @map("item_categoria") @db.VarChar(100)
  itemTipoCosto     String        @map("item_tipo_costo") @db.VarChar(10)
  cantidad          Int           @default(1)
  costoUnitarioErp  Decimal?      @map("costo_unitario_erp") @db.Decimal(18, 4)
  precioVenta       Decimal?      @map("precio_venta") @db.Decimal(18, 2)
  precioVentaOrigen String        @default("LISTA") @map("precio_venta_origen") @db.VarChar(10)
  congeladoEn       DateTime?     @map("congelado_en")
  orden             Int           @default(0)
  cubreDescanso     Int           @default(0) @map("cubre_descanso")
  horasSemana       Int           @default(0) @map("horas_semana")
  personas          Int           @default(1)
  turnoCodigo       Int?          @map("turno_codigo")
  uniformeCodigo    String?       @map("uniforme_codigo") @db.VarChar(50)
  combosRhSelec     String?       @map("combos_rh_seleccionados") @db.Text
  esComboRhId       Int?          @map("es_combo_rh_id") @db.TinyInt
  bonos             Json?         @map("bonos")
  comboParentId     Int?          @map("combo_parent_id")
  itemId            Int           @map("item_id")
  item              Item          @relation(fields: [itemId], references: [id])
  nodo              Nodo          @relation(fields: [nodoId], references: [id], onDelete: Cascade)
  comboParent       NodoRecurso?  @relation("ComboParent", fields: [comboParentId], references: [id], onDelete: SetNull)
  combosHijos       NodoRecurso[] @relation("ComboParent")
  recetaSnap        RecetaSnap[]

  @@index([itemId], map: "costeos_nodo_recurso_item_id_fkey")
  @@index([nodoId], map: "costeos_nodo_recurso_nodo_id_fkey")
  @@index([comboParentId], map: "costeos_nodo_recurso_combo_parent_id_fkey")
  @@map("costeos_nodo_recurso")
}


model RecetaSnap {
  id            Int         @id @default(autoincrement())
  nivel         Int
  itemNombre    String      @map("item_nombre") @db.VarChar(200)
  itemCategoria String      @map("item_categoria") @db.VarChar(100)
  itemTipoCosto String      @map("item_tipo_costo") @db.VarChar(10)
  cantidad      Decimal     @db.Decimal(10, 4)
  costoUnitario Decimal     @map("costo_unitario") @db.Decimal(18, 4)
  subtotal      Decimal     @db.Decimal(18, 2)
  esOpcional    Boolean     @default(false) @map("es_opcional")
  fueEliminado  Boolean     @default(false) @map("fue_eliminado")
  nodoRecursoId Int         @map("nodo_recurso_id")
  itemId        Int         @map("item_id")
  item          Item        @relation(fields: [itemId], references: [id])
  nodoRecurso   NodoRecurso @relation(fields: [nodoRecursoId], references: [id], onDelete: Cascade)

  @@index([itemId], map: "costeos_receta_snap_item_id_fkey")
  @@index([nodoRecursoId], map: "costeos_receta_snap_nodo_recurso_id_fkey")
  @@map("costeos_receta_snap")
}

model Costeo {
  id              Int                     @id @default(autoincrement())
  contratoId      Int                     @unique @map("contrato_id")
  version         Int                     @default(1)
  costeoPadreId   Int?                    @map("costeo_padre_id")
  estado          String                  @default("BORRADOR") @db.VarChar(20)
  overheadPct     Decimal                 @default(0.00) @map("overhead_pct") @db.Decimal(5, 2)
  contingenciaPct Decimal                 @default(0.00) @map("contingencia_pct") @db.Decimal(5, 2)
  margenPct       Decimal                 @default(0.00) @map("margen_pct") @db.Decimal(5, 2)
  notas           String?                 @db.Text
  aprobadoPor     Int?                    @map("aprobado_por")
  aprobadoEn      DateTime?               @map("aprobado_en")
  creadoPor       Int                     @map("creado_por")
  creadoEn        DateTime                @default(now()) @map("creado_en")
  modificadoEn    DateTime                @updatedAt @map("modificado_en")
  tipoCosteoId    Int?                    @map("tipo_costeo_id")
  auditLogs       AuditLog[]
  aprobador       Usuario?                @relation("CosteoAprobador", fields: [aprobadoPor], references: [id])
  contrato        Contrato                @relation(fields: [contratoId], references: [id])
  costeoPadre     Costeo?                 @relation("VersionesCosteo", fields: [costeoPadreId], references: [id])
  versiones       Costeo[]                @relation("VersionesCosteo")
  creador         Usuario                 @relation("CosteoCreador", fields: [creadoPor], references: [id])
  tipoCosteo      TipoCosteo?             @relation(fields: [tipoCosteoId], references: [id])
  historiales     HistorialAutoGuardado[]
  resultado       Resultado?

  @@index([aprobadoPor], map: "costeos_costeo_aprobado_por_fkey")
  @@index([costeoPadreId], map: "costeos_costeo_costeo_padre_id_fkey")
  @@index([creadoPor], map: "costeos_costeo_creado_por_fkey")
  @@index([tipoCosteoId], map: "costeos_costeo_tipo_costeo_id_fkey")
  @@map("costeos_costeo")
}

model Resultado {
  id                 Int                  @id @default(autoincrement())
  costeoId           Int                  @unique @map("costeo_id")
  costoMensual       Decimal              @map("costo_mensual") @db.Decimal(18, 2)
  costoAnual         Decimal              @map("costo_anual") @db.Decimal(18, 2)
  costoTotalProyecto Decimal              @map("costo_total_proyecto") @db.Decimal(18, 2)
  ventaMensual       Decimal              @map("venta_mensual") @db.Decimal(18, 2)
  ventaAnual         Decimal              @map("venta_anual") @db.Decimal(18, 2)
  ventaTotalProyecto Decimal              @map("venta_total_proyecto") @db.Decimal(18, 2)
  grossMarginPct     Decimal              @map("gross_margin_pct") @db.Decimal(5, 2)
  roiPct             Decimal              @map("roi_pct") @db.Decimal(5, 2)
  calculadoEn        DateTime             @map("calculado_en")
  costeo             Costeo               @relation(fields: [costeoId], references: [id], onDelete: Cascade)
  categorias         ResultadoCategoria[]

  @@map("costeos_resultado")
}

model ResultadoCategoria {
  id           Int       @id @default(autoincrement())
  resultadoId  Int       @map("resultado_id")
  categoria    String    @db.VarChar(100)
  costoMensual Decimal   @map("costo_mensual") @db.Decimal(18, 2)
  costoTotal   Decimal   @map("costo_total") @db.Decimal(18, 2)
  ventaMensual Decimal?  @map("venta_mensual") @db.Decimal(18, 2)
  resultado    Resultado @relation(fields: [resultadoId], references: [id], onDelete: Cascade)

  @@index([resultadoId], map: "costeos_resultado_categoria_resultado_id_fkey")
  @@map("costeos_resultado_categoria")
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  tabla        String   @db.VarChar(100)
  registroId   Int      @map("registro_id")
  accion       String   @db.VarChar(20)
  usuarioId    Int      @map("usuario_id")
  costeoId     Int?     @map("costeo_id")
  datosAntes   String?  @map("datos_antes") @db.LongText
  datosDespues String?  @map("datos_despues") @db.LongText
  en           DateTime @default(now())
  costeo       Costeo?  @relation(fields: [costeoId], references: [id])
  usuario      Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([tabla, registroId])
  @@index([costeoId])
  @@index([usuarioId], map: "costeos_audit_log_usuario_id_fkey")
  @@map("costeos_audit_log")
}

model TipoCosteo {
  id                Int            @id @default(autoincrement())
  empresaId         Int            @default(1) @map("empresa_id")
  nombre            String         @db.VarChar(200)
  lineaEtiqueta     String         @default("Línea") @map("linea_etiqueta") @db.VarChar(50)
  baseEvaluacion    BaseEvaluacion @default(GLOBAL) @map("base_evaluacion")
  fijarPlazo        Int            @default(0) @map("fijar_plazo")
  manejoPlazo       String         @default("NO_APLICA") @map("manejo_plazo") @db.VarChar(20)
  cantidadNiveles   Int            @default(2) @map("cantidad_niveles")
  etiquetasNiveles  String?        @map("etiquetas_niveles") @db.VarChar(200)
  nivelConDireccion Int?           @default(1) @map("nivel_con_direccion")
  coloresNiveles    String?        @map("colores_niveles") @db.VarChar(200)
  iconosNiveles     String?        @map("iconos_niveles") @db.VarChar(200)
  activo            Boolean        @default(true)
  creadoEn          DateTime       @default(now()) @map("creado_en")
  modificadoEn      DateTime       @updatedAt @map("modificado_en")
  registroVersion   Int            @default(1) @map("registro_version")
  costeos           Costeo[]

  @@map("costeos_tipo_costeo")
}

model HistorialAutoGuardado {
  id        Int      @id @default(autoincrement())
  costeoId  Int      @map("costeo_id")
  usuarioId Int      @map("usuario_id")
  datos     String   @db.LongText
  creadoEn  DateTime @default(now()) @map("creado_en")
  costeo    Costeo   @relation(fields: [costeoId], references: [id], onDelete: Cascade)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([costeoId], map: "costeos_historial_autoguardado_costeo_id_fkey")
  @@index([usuarioId], map: "costeos_historial_autoguardado_usuario_id_fkey")
  @@map("costeos_historial_autoguardado")
}

model Empresa {
  id                  Int                   @id @default(autoincrement())
  nit                 String                @map("empresa_nit") @db.VarChar(20)
  nombre              String                @map("empresa_nombre") @db.VarChar(100)
  razonSocial         String                @map("empresa_razon_social") @db.VarChar(100)
  codigoErp           String                @default("") @map("codigo_erp") @db.VarChar(10)
  usuarioCreo         Int                   @default(0) @map("usuario_creo")
  fechaCreo           DateTime              @default(now()) @map("fecha_creo")
  registroVersion     Int                   @default(0) @map("registro_version")
  categorias          CategoriaItem[]
  configuracionesSync EmpresaCatalogoSync[]
  tiposComboRH        TipoComboRH[]
  tiposCombo          TipoCombo[]

  @@map("costeos_empresa")
}

model EmpresaCatalogoSync {
  id          Int     @id @default(autoincrement())
  empresaId   Int     @map("empresa_id")
  catalogo    String  @db.VarChar(50)
  sincronizar Boolean @default(false)
  empresa     Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, catalogo])
  @@map("costeos_empresa_catalogo_sync")
}

model CategoriaItem {
  id              Int      @id @default(autoincrement())
  empresaId       Int      @default(0) @map("empresa_id")
  nombre          String   @db.VarChar(100)
  prioridad       Int      @default(0)
  usuarioCreo     Int      @default(0) @map("usuario_creo")
  fechaCreo       DateTime @default(now()) @map("fecha_creo")
  registroVersion Int      @default(1) @map("registro_version")
  empresa         Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade, map: "empresa_id")
  items           Item[]

  @@index([empresaId], map: "empresa_id_idx")
  @@map("costeos_categoria")
}

model Item {
  id                    Int             @id @default(autoincrement())
  empresaId             Int             @default(0) @map("empresa_id")
  descripcion           String          @db.VarChar(100)
  codigoErp             String?         @map("codigo_erp") @db.VarChar(15)
  categoriaId           Int             @map("categoria_id")
  tipoComboId           Int?            @map("tipo_combo_id")
  unidadMedida          String          @map("unidad_medida") @db.VarChar(10)
  tipoItem              Int             @default(0) @map("tipo_item") @db.TinyInt
  tipoProducto          Int             @default(0) @map("tipo_producto") @db.TinyInt
  venta                 Int             @default(0) @db.TinyInt
  precioVentaCero       Boolean         @default(false) @map("precio_venta_cero")
  recurrente            Int             @default(0) @db.TinyInt
  recurrenteGasto       Int             @default(0) @map("recurrente_gasto") @db.TinyInt
  manejoCostos          Int             @default(0) @map("manejo_costos") @db.TinyInt
  costoReferenciaItemId Int?            @map("costo_referencia_item_id")
  tipo                  Int             @default(0) @db.TinyInt
  perfil                Int             @default(0) @db.TinyInt
  uniforme              Int             @default(0) @db.TinyInt
  activo                Boolean         @default(true)
  usuarioCreo           Int             @default(0) @map("usuario_creo")
  fechaCreo             DateTime        @default(now()) @map("fecha_creo")
  registroVersion       Int             @default(1) @map("registro_version")
  categoria             CategoriaItem   @relation(fields: [categoriaId], references: [id])
  tipoCombo             TipoCombo?      @relation("ItemTipoComboFK", fields: [tipoComboId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  costoReferenciaItem   Item?           @relation("CostoReferencia", fields: [costoReferenciaItemId], references: [id], onDelete: SetNull)
  itemsQueReferencian   Item[]          @relation("CostoReferencia")
  nodoRecursos          NodoRecurso[]
  recetaSnaps           RecetaSnap[]
  combosPrincipal       DetalleCombo[]  @relation("ItemPrincipal")
  combosSecundario      DetalleCombo[]  @relation("ItemSecundario")
  costos                ItemCosto[]
  costosRef             ItemCostoRef[]
  tiposComboRH          ItemTipoComboRH[]
  tiposCombo            ItemTipoCombo[]

  @@index([categoriaId], map: "CATEGORIA")
  @@index([empresaId], map: "costeos_item_empresa_id_fkey")
  @@index([tipoComboId], map: "costeos_item_tipo_combo_id_fkey")
  @@index([costoReferenciaItemId], map: "costeos_item_costo_referencia_item_id_fkey")
  @@map("costeos_item")
}

model ItemCosto {
  id          Int      @id @default(autoincrement())
  itemId      Int      @map("item_id")
  costo       Decimal  @db.Decimal(18, 4)
  fecha       DateTime @db.Date
  fechaAgrego DateTime @default(now()) @map("fecha_agrego")
  usuarioId   Int      @map("usuario_id")
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId], map: "costeo_item_costo_item_id_fkey")
  @@map("costeo_item_costo")
}

// Historial de porcentajes de costo por referencia (manejoCostos = 3).
// Análogo a ItemCosto pero guarda pct en lugar de costo absoluto.
// El ítem de referencia vive en Item.costoReferenciaItemId (inmutable una vez fijado).
model ItemCostoRef {
  id          Int      @id @default(autoincrement())
  itemId      Int      @map("item_id")
  pct         Decimal  @db.Decimal(5, 2)
  fecha       DateTime @db.Date
  fechaAgrego DateTime @default(now()) @map("fecha_agrego")
  usuarioId   Int      @map("usuario_id")
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId], map: "costeo_item_costo_ref_item_id_fkey")
  @@map("costeo_item_costo_ref")
}

model Pais {
  id              Int            @id @default(autoincrement())
  codigo          String         @map("pais_codigo") @db.VarChar(5)
  nombre          String         @map("pais_nombre") @db.VarChar(50)
  usuarioCreo     Int            @default(0) @map("usuario_creo")
  fechaCreo       DateTime       @default(now()) @map("fecha_creo")
  registroVersion Int            @default(1) @map("registro_version")
  departamentos   Departamento[]

  @@map("costeos_pais")
}

model Departamento {
  id              Int         @id @default(autoincrement())
  paisId          Int         @default(0) @map("pais_id")
  codigo          Int         @default(0) @map("departamento_codigo")
  nombre          String      @map("departamento_nombre") @db.VarChar(100)
  usuarioCreo     Int         @default(0) @map("usuario_creo")
  fechaCreo       DateTime    @default(now()) @map("fecha_creo")
  registroVersion Int         @default(1) @map("registro_version")
  pais            Pais        @relation(fields: [paisId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  municipios      Municipio[]

  @@index([paisId])
  @@map("costeos_departamento")
}

model Municipio {
  id              Int          @id @default(autoincrement())
  paisId          Int          @default(0) @map("pais_id")
  departamentoId  Int          @default(0) @map("departamento_id")
  codigo          Int          @default(0) @map("municipio_codigo")
  nombre          String       @map("municipio_nombre") @db.VarChar(100)
  longitud        String?      @db.VarChar(45)
  latitud         String?      @db.VarChar(45)
  usuarioCreo     Int          @default(0) @map("usuario_creo")
  fechaCreo       DateTime     @default(now()) @map("fecha_creo")
  registroVersion Int          @default(1) @map("registro_version")
  departamento    Departamento @relation(fields: [departamentoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([paisId, departamentoId])
  @@index([departamentoId], map: "costeos_municipio_departamento_id_fkey")
  @@map("costeos_municipio")
}

model DetalleCombo {
  id                   Int      @id @default(autoincrement())
  empresaId            Int      @default(0) @map("empresa_id")
  tipoItem             Int      @default(0) @map("tipo_item") @db.TinyInt
  productoPrincipalId  Int      @default(0) @map("producto_principal")
  productoSecundarioId Int      @default(0) @map("producto_secundario")
  nuevoCantidad        Decimal  @default(0.00000000) @map("nuevo_cantidad") @db.Decimal(18, 8)
  nuevoIncluido        Int      @default(0) @map("nuevo_incluido") @db.TinyInt
  nuevoRequerido       Int      @default(0) @map("nuevo_requerido") @db.TinyInt
  renovacionCantidad   Decimal  @default(0.00000000) @map("renovacion_cantidad") @db.Decimal(18, 8)
  renovacionIncluido   Int      @default(0) @map("renovacion_incluido") @db.TinyInt
  renovacionRequerido  Int      @default(0) @map("renovacion_requerido") @db.TinyInt
  usuarioCreo          Int      @default(0) @map("usuario_creo")
  fechaCreo            DateTime @default(now()) @map("fecha_creo")
  registroVersion      Int      @default(1) @map("registro_version")

  productoPrincipal  Item @relation("ItemPrincipal", fields: [productoPrincipalId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productoSecundario Item @relation("ItemSecundario", fields: [productoSecundarioId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([productoPrincipalId, productoSecundarioId], map: "ITEM_COMO")
  @@map("costeos_detalle_combo")
}

enum BaseEvaluacion {
  GLOBAL
  MENSUAL
}

// ─── Tipos de Combo RH ────────────────────────────────────────────────────────

// TipoComboRH — Tipos configurables de ítems adicionales asociados a RRHH.
// Ej: Uniforme, Equipo Seguridad, Comunicación.
// Máx. 8 tipos activos por empresa (validado en el service).
model TipoComboRH {
  id           Int               @id @default(autoincrement())
  empresaId    Int               @map("empresa_id")
  nombre       String            @db.VarChar(100)
  icono        String?           @db.VarChar(50)
  orden        Int               @default(0)
  requerido    Boolean           @default(false)
  activo       Boolean           @default(true)
  creadoEn     DateTime          @default(now()) @map("creado_en")
  modificadoEn DateTime          @updatedAt @map("modificado_en")
  empresa      Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  items        ItemTipoComboRH[]

  @@index([empresaId], map: "costeos_tipo_combo_rh_empresa_id_fkey")
  @@map("costeos_tipo_combo_rh")
}

// ItemTipoComboRH — Tabla pivote con dos roles:
// - NECESITA: ítem RH que necesita selección de este tipo al agregarse al costeo
// - DISPONIBLE: ítem no-RH que puede ser seleccionado como este tipo
model ItemTipoComboRH {
  itemId        Int                    @map("item_id")
  tipoComboRHId Int                    @map("tipo_combo_rh_id")
  rol           ItemComboRHRol         @default(DISPONIBLE)
  item          Item                   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tipoComboRH   TipoComboRH            @relation(fields: [tipoComboRHId], references: [id], onDelete: Cascade)

  @@id([itemId, tipoComboRHId])
  @@index([tipoComboRHId], map: "costeos_item_tipo_combo_rh_tipo_id_fkey")
  @@map("costeos_item_tipo_combo_rh")
}

enum ItemComboRHRol {
  NECESITA    // Ítem RH: necesita este tipo cuando se agrega al costeo
  DISPONIBLE  // Ítem no-RH: puede ser seleccionado para este tipo
}

// ─── Tipos de Combo (nueva arquitectura — aplica a cualquier tipo de ítem) ────

// TipoCombo — Tipos configurables de ítems adicionales (sin límite de tipos activos).
// Aplica a cualquier tipo de ítem, no solo a RH.
model TipoCombo {
  id              Int             @id @default(autoincrement())
  empresaId       Int             @default(0) @map("empresa_id")
  nombre          String          @db.VarChar(100)
  icono           String?         @db.VarChar(50)
  usuarioCreo     Int             @default(0) @map("usuario_creo")
  fechaCreo       DateTime        @default(now()) @map("fecha_creo")
  registroVersion Int             @default(1) @map("registro_version")
  empresa         Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  items           Item[]          @relation("ItemTipoComboFK")
  itemTiposCombos ItemTipoCombo[]

  @@index([empresaId], map: "costeos_tipo_combo_empresa_id_fkey")
  @@map("costeos_tipo_combo")
}

// ItemTipoCombo — Tabla pivote entre Item y TipoCombo.
// Indica qué Tipos Combo tiene configurado un ítem, y si cada uno es obligatorio.
model ItemTipoCombo {
  itemId        Int       @map("item_id")
  tipoComboId   Int       @map("tipo_combo_id")
  obligatorio   Boolean   @default(false)
  item          Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tipoCombo     TipoCombo @relation(fields: [tipoComboId], references: [id], onDelete: Cascade)

  @@id([itemId, tipoComboId])
  @@index([tipoComboId], map: "costeos_item_tipo_combo_tipo_id_fkey")
  @@map("costeos_item_tipo_combo")
}
